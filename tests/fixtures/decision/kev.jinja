{#- jaredpalmer/kev-4b (github.com/jaredpalmer/kev, kev.api.to_record + kev.model.encode/rows_of): one causal row per
    question = <state> state <q> instructions (<opt> option </opt>)* <decide>, special tokens reused from the Qwen vocab.
    Marks sit after each </opt> and after <decide>: the head reads the token before every mark. -#}
{#- kev.model.user_tokens: caller text never yields control tokens, re.sub(r"<\|([A-Za-z0-9_]+)\|>", r"<¦\1¦>", t) -#}
{%- macro esc(t) -%}
{%- set parts = t.split("<|") -%}
{{- parts[0] -}}
{%- for p in parts[1:] -%}
{%- set i = p.find("|>") -%}
{%- set name = p[:i] -%}
{%- set bare = name.replace("_", "") -%}
{%- if i > 0 and name.isascii() and (bare == "" or bare.isalnum()) -%}
{{- "<¦" ~ name ~ "¦>" ~ p[i + 2:] -}}
{%- else -%}
{{- "<|" ~ p -}}
{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{#- kev.api.render: str | object | array -> labelled text (field names kept as labels) -#}
{%- macro render(v, indent=0) -%}
{%- set pad = "  " * indent -%}
{%- if v is none -%}
{%- elif v is mapping -%}
{%- for k, x in v.items() -%}
{{- "\n" if not loop.first -}}
{%- if x is mapping or (x is iterable and x is not string) -%}
{{- pad ~ k ~ ":\n" ~ render(x, indent + 1) -}}
{%- else -%}
{{- pad ~ k ~ ": " ~ render(x) -}}
{%- endif -%}
{%- endfor -%}
{%- elif v is iterable and v is not string -%}
{%- for x in v -%}
{{- "\n" if not loop.first -}}
{{- pad ~ "- " ~ render(x, indent + 1).lstrip() -}}
{%- endfor -%}
{%- else -%}
{{- v | string -}}
{%- endif -%}
{%- endmacro -%}
{{- "<|fim_prefix|>" ~ esc(render(state)) ~ "<|fim_middle|>" ~ esc(render(question.instructions)) -}}
{%- for option in question.options -%}
{%- set d = question.descriptions[loop.index0] -%}
{%- if question.type == "score" -%}
{%- set text = render(d) -%}
{%- else -%}
{#- kev.api.option_text; noul options are named no / yes (option order false, true: decision_config.noul_options) -#}
{%- set name = {"false": "no", "true": "yes"}[option] if question.type == "noul" else option -%}
{%- set text = name if (d is none or d == "") else name ~ ": " ~ render(d) -%}
{%- endif -%}
{{- "<|box_start|>" ~ esc(text) ~ "<|box_end|><|mark|>" -}}
{%- endfor -%}
{{- "<|fim_suffix|><|mark|>" -}}
